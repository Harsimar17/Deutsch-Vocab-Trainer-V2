[
  {
    "key": "pos2",
    "name": "Verb in position 2",
    "rule": "In a normal statement the conjugated verb is always the SECOND box. Whatever you put first — subject, time, an object — the verb comes right after it, and the subject slides in behind the verb.",
    "skeleton": [
      {
        "text": "etwas",
        "role": "front"
      },
      {
        "text": "Verb",
        "role": "v2"
      },
      {
        "text": "… der Rest …",
        "role": "mid"
      }
    ],
    "examples": [
      {
        "en": "I drink a strong coffee in the morning.",
        "chunks": [
          {
            "text": "Ich",
            "role": "front",
            "cap": "Subjekt = ①"
          },
          {
            "text": "trinke",
            "role": "v2"
          },
          {
            "text": "am Morgen",
            "role": "time"
          },
          {
            "text": "einen starken Kaffee",
            "role": "obj"
          }
        ]
      },
      {
