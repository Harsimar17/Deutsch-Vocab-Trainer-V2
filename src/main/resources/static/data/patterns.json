  {
    "key": "umzu",
    "name": "um … zu (purpose)",
    "rule": "To say WHY someone does something: 'um' + … + 'zu' + infinitive at the end. The um-part has no subject of its own — it's the same person as the main clause.",
    "skeleton": [
      {
        "text": "Hauptsatz",
        "role": "mid",
        "cap": "wer + tut was"
      },
      {
        "text": "um",
        "role": "konj"
      },
      {
        "text": "… Objekt / Angabe …",
        "role": "mid"
      },
      {
        "text": "zu + Infinitiv",
        "role": "end",
        "cap": "der Zweck"
      }
    ],
    "examples": [
